# ============================================================
# TradeBridge Africa — Frontend environment
# Copy this file to .env and adjust for your local setup.
# ============================================================

# ---------- Backend
# Base URL of the API Gateway. UI requests go to ${BFF_URL}/api/v1/**
BFF_URL=http://localhost:8080

# Webpack dev server port
PORT=3000

# ---------- Application
APP_NAME=TradeBridge Africa
APP_ENV=local

# ---------- Auth
# Seconds before access-token expiry to proactively refresh
TOKEN_REFRESH_THRESHOLD_SECONDS=120

# ---------- Locales
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,pt

# ---------- Telemetry (Grafana Faro)
ENABLE_FARO=false
FARO_URL=

# ---------- Dev flags
ENABLE_DEBUG_LOGS=true