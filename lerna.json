{
  "$schema": "https://json.schemastore.org/lerna.json",
  "version": "0.1.0",
  "npmClient": "yarn",
  "useWorkspaces": true,
  "packages": [
    "modules/*",
    "ui"
  ],
  "command": {
    "version": {
      "allowBranch": "main",
      "conventionalCommits": true,
      "message": "chore(release): publish %s"
    },
    "publish": {
      "access": "restricted",
      "registry": "https://registry.npmjs.org/"
    }
  }
}